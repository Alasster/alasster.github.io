# Скопируй этот файл в .env и заполни необходимые ключи.
GITHUB_TOKEN=
ALASSTER_GITHUB_REPO=Alasster/alasster.github.io

# Генератор КСП (Google Gemini API)
# Получите бесплатный ключ здесь: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
KSP_TEACHER=Кадыржанов Ж.К.
# Путь к общей папке Google Диска (по умолчанию ../КСП)
KSP_OUTPUT_ROOT=C:\Users\stron\Мой диск\КСП

# Resend Email Service (Сброс пароля)
RESEND_API_KEY=
RESEND_FROM_EMAIL=ALASSTER <noreply@alasster.site>
